# Maintainer: huskie <sammileenk@gmail.com>
pkgname=huskie-board-git
_pkgname=huskie-board
pkgver=0.91
pkgrel=1
pkgdesc='Gboard-style touch keyboard for KDE Plasma 6 on Wayland'
arch=('x86_64' 'aarch64')
url='https://github.com/leenknegt-eu/huskie-board'
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'kcoreaddons' 'ki18n'
         'layer-shell-qt' 'wayland')
makedepends=('git' 'cmake' 'extra-cmake-modules' 'wayland-protocols' 'ninja')
optdepends=('plasma-workspace: Klipper clipboard history integration')
provides=("$_pkgname")
conflicts=("$_pkgname" tastiera-git)
replaces=(tastiera-git)
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf '0.91.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S "$_pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
